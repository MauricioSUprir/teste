      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        -20
      ],
      "parameters": {
        "jsCode": "const m=$input.first().json.message; return [{json:{ texto: m.text || m.caption || '[O dono enviou algo sem texto (foto, áudio ou arquivo). Diga que ainda não consegue ler esse tipo de mensagem.]', canal:'telegram', sessao:String(m.chat.id) }}];"
      }
    },
    {
      "id": "c4",
      "name": "Núcleo",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        660,
        -20
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "WJlEDEq47GE6BCzE",
          "mode": "id"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "c5",
      "name": "Telegram - Responde",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        880,
        -20
      ],
      "parameters": {
        "chatId": "={{ $('Telegram - Recebe').first().json.message.chat.id }}",
        "text": "={{ String($json.resposta || 'Desculpe, não consegui responder agora.').slice(0, 4000) }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "8laolpRHTWXd6lke",
          "name": "Telegram account"
        }
      },
