{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck.sh",
            "timeout": 90,
            "statusMessage": "Checando TypeScript..."
          }
        ]
      }
    ]
  },
  "autoMemoryEnabled": true,
  "fileCheckpointingEnabled": true
}
