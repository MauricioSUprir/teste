# ===== Storefront (apps/storefront) — variáveis de BUILD =====
# URL pública do servidor BeautyNow. Vazio = modo demonstração
# (código de verificação aparece na tela; pedidos só locais).
NEXT_PUBLIC_SERVIDOR_URL=

# ===== Sincronização do catálogo (scripts/sincronizar-catalogo.mjs) =====
# Chave da API do Hub Suprir — NUNCA commitar o valor real.
HUB_API_KEY=
# Access Token do Mercado Pago (teste ou produção) — liga pagamento real
MP_ACCESS_TOKEN=
# Bling ERP (aplicativo em developer.bling.com.br) — fatura os pedidos do site
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
# URL pública do site (retornos do Checkout Pro)
SITE_URL=https://mauriciosuprir.github.io/teste
HUB_API_URL=https://comercial.thebeautyhub.app/api/loja

# ===== Servidor (apps/servidor) =====
PORTA=4000
ORIGENS_PERMITIDAS=https://mauriciosuprir.github.io,http://localhost:3000
# "brevo" (envio via HTTPS — use no Render gratuito, que bloqueia SMTP) |
# "gmail" (SMTP — funciona em VPS) | "console" (teste: código sai no log)
EMAIL_MODO=console
EMAIL_USUARIO=lojabeautynow@gmail.com
# Chave de API do Brevo (começa com xkeysib-): app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Senha de APP do Gmail (não é a senha normal): Conta Google → Segurança →
# Verificação em 2 etapas → Senhas de app
EMAIL_SENHA_APP=
# Quem recebe a notificação de cada venda (separar por vírgula)
ADMIN_NOTIFICACAO_EMAILS=lojabeautynow@gmail.com
