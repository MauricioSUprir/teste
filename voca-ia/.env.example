# Provedor de IA do servidor (opcional). Se preencher, todo mundo que abrir o
# app ja usa a IA sem precisar colar chave nenhuma. Sem isso, cada pessoa
# configura o proprio provedor em Perfil -> Modo IA, ou fica no modo offline.
#
# Valores aceitos: gemini | groq | openrouter | cerebras | mistral | ollama | anthropic
VOCA_PROVIDER=gemini
VOCA_API_KEY=coloque-sua-chave-aqui

# Modelos (opcional — cada provedor ja tem um padrao)
# VOCA_CHAT_MODEL=gemini-2.5-flash
# VOCA_REPORT_MODEL=gemini-2.5-flash

# Ollama rodando em outro endereco (opcional)
# OLLAMA_URL=http://localhost:11434/v1

# Porta do servidor (opcional, padrao 8787)
PORT=8787
