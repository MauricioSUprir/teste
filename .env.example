# Copie este arquivo para .env e preencha os valores.
#   cp .env.example .env

# Banco de dados local (SQLite) — não precisa mudar
DATABASE_URL="file:./dev.db"

# ── Deploy na internet (opcional — veja docs/DEPLOY.md) ──────
# Banco Turso (SQLite na nuvem). Deixe vazio para usar o banco local.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
# Senha única de acesso ao app quando publicado na internet.
# Deixe vazio no uso local para não pedir senha.
SENHA_DE_ACESSO=""

# ── Assistente de IA — escolha UMA das opções (ou as duas) ───
# Opção gratuita: Gemini (Google). Crie a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Opção paga por uso: Claude (Anthropic). https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
# Se tiver as duas chaves, escolha qual usar: "claude" ou "gemini"
IA_PROVEDOR=""
# Modelos (opcionais)
CLAUDE_MODEL="claude-opus-5"
GEMINI_MODEL="gemini-2.5-flash"

# ── Notificações push (navegador/celular) ────────────────────
# Gere as chaves com:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Em produção (Vercel), protege o disparo automático do resumo diário.
# Qualquer texto aleatório longo serve.
CRON_SECRET=""

# ── Integrações Google (Gmail, Classroom, Drive) ─────────────
# Passo a passo completo em docs/INTEGRACOES.md
# Crie as credenciais em https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Em desenvolvimento local, mantenha assim:
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"
