# Copie este arquivo para .env e preencha os valores.
#   cp .env.example .env

# Banco de dados local (SQLite) — não precisa mudar
DATABASE_URL="file:./dev.db"

# ── Assistente de IA (Claude) ────────────────────────────────
# Crie sua chave em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
# Modelo usado pelo assistente (opcional)
CLAUDE_MODEL="claude-opus-5"

# ── Integrações Google (Gmail, Classroom, Drive) ─────────────
# Passo a passo completo em docs/INTEGRACOES.md
# Crie as credenciais em https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Em desenvolvimento local, mantenha assim:
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"
